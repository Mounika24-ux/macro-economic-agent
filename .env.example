# ==============================================================================
# CrowdWisdomTrading Macroeconomic Sentiment Agent - Environment Template
# ==============================================================================
# Copy this file to .env and populate with your personal API credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Pipeline Operation Mode: "live" (uses active API keys), "fallback" (yfinance/CSVs), or "demo" (labeled synthetic)
PIPELINE_MODE=demo

# Apify Economic Event Actor Configuration
# Sign up at https://apify.com/ and obtain your API token.
# Specify any compatible economic calendar actor ID (e.g., "trudax/economic-calendar" or custom actor)
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_ACTOR_ID=pintostudio/economic-calendar-data-investing-com
APIFY_LOOKBACK_DAYS=180

# Tavily Macroeconomic News Search
# Sign up at https://tavily.com/ to generate an API key
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_MAX_RESULTS_PER_TOPIC=10

# Exa Search API (Alternative / Supplementary Macro Search)
# Sign up at https://exa.ai/ to generate an API key
EXA_API_KEY=your_exa_api_key_here
EXA_MAX_RESULTS=10

# Database Configuration
# Local SQLite database path (SQLAlchemy connection string format)
DATABASE_URL=sqlite:///data/macro_economic.db

# Market Data Configuration
DEFAULT_SYMBOL=SPY
MARKET_DATA_SOURCE=yfinance  # options: yfinance, csv, synthetic

# Trading Simulation & Financial Metrics Assumptions
COMMISSION_PER_SHARE=0.001
SLIPPAGE_BPS=1.5
ANNUAL_RISK_FREE_RATE=0.045  # 4.5% baseline risk-free rate for Sharpe calculation
TRADING_DAYS_PER_YEAR=252

# Machine Learning & Walk-Forward Validation
WF_N_SPLITS=5
WF_WINDOW_TYPE=expanding    # options: expanding, rolling
WF_TRAIN_SIZE_DAYS=90
WF_TEST_SIZE_DAYS=30
WF_PURGE_DAYS=2             # Gap between train and test to prevent label overlap leakage

# Logging & Output
LOG_LEVEL=INFO
